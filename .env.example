# Scoring uses OpenAI. Put the key in OPENAI_API_KEY.
LLM_PROVIDER=openai

# Gemini (default — required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# Fast model for high-volume scoring; deep-reasoning model for the few writing calls
GEMINI_SCORER_MODEL=gemini-3.6-flash
GEMINI_WRITER_MODEL=gemini-3.1-pro-preview
# Thinking levels: minimal|low|medium|high (empty omits thinking_config entirely)
GEMINI_SCORER_THINKING_LEVEL=low
GEMINI_WRITER_THINKING_LEVEL=high
# Tried in order when the primary model is overloaded (503) or rate-limited
GEMINI_FALLBACK_MODELS=["gemini-3.8-flash","gemini-3.6-flash"]
# Concurrent scoring workers (raise on paid Gemini / Anthropic; keep low on free tier)
SCORER_CONCURRENCY=8
# Retry budget per model for transient 429/503/500 errors
LLM_MAX_ATTEMPTS=4
LLM_RETRY_MAX_WAIT_S=30
# Output budgets. Gemini thinking tokens are drawn from these, so keep headroom.
SCORE_MAX_TOKENS=1024
WRITER_MAX_TOKENS=2048

# Scoring / filtering thresholds
# Code default is false. Production GitHub Actions sets INTERNSHIP_ONLY=true.
# Set it true for any run whose DATABASE_URL is the production database.
# INTERNSHIP_ONLY=true
TIER_ONE_MIN_SCORE=85
TIER_TWO_MIN_SCORE=65
# JD chars sent to the scorer (head+tail kept, middle trimmed)
MAX_JD_CHARS=9000
ENABLE_SENIORITY_FILTER=true
# Reject JDs demanding more YOE than this; leave unset to derive from profile.yaml
# MAX_REQUIRED_YEARS_EXPERIENCE=
YEARS_EXPERIENCE_SLACK=3

# OpenAI. Scoring and embeddings both use this key.
OPENAI_API_KEY=
OPENAI_SCORER_MODEL=gpt-5-mini
OPENAI_WRITER_MODEL=gpt-5-mini

# Anthropic (optional fallback when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here
SCORER_MODEL=claude-haiku-4-5-20251001
WRITER_MODEL=claude-sonnet-4-5-20250929

# Telegram (required for review bot in Step 6+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT=30
# Optional (Step 7 production webhook)
# TELEGRAM_WEBHOOK_URL=https://your.domain/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=change-me

# Database
# Local / tests (default):
DATABASE_URL=sqlite+aiosqlite:///storage/job_agent.db
# Neon Postgres (GitHub Actions cron / production) — use the async driver:
# DATABASE_URL=postgresql+asyncpg://neondb_owner:PASSWORD@ep-xxx.us-west-2.aws.neon.tech/neondb?sslmode=require
# Plain postgresql:// from the Neon console is also accepted (auto-upgraded to +asyncpg;
# sslmode= is rewritten to ssl= for asyncpg).

# Schedule (3x/day, used in Step 7)
SCHEDULE_TIMES=["08:00","13:00","18:00"]
TIMEZONE=America/Los_Angeles
ENABLE_APPLY=true
ENABLE_REVIEWS=true
# Generate LinkedIn/Indeed application prep packs (Markdown + PDF via Telegram)
ENABLE_PREP_PACK=true
# Generate Telegram skill suggestions after scoring (diff vs role baseline)
ENABLE_SUGGESTIONS=true
# Auto peer-benchmark Tier-1 jobs in the pipeline (needs ENABLE_LINKEDIN_SCRAPE + session)
ENABLE_BENCHMARK=false

# Two-tier resume tailoring
RESUME_SKILL_PLACEMENT=skills_only
RESUME_USE_LLM_TAILORING=true
RESUME_BASELINE_JD_LIMIT=20
BASELINES_DIR=storage/baselines
BENCHMARKS_DIR=storage/benchmarks

# LinkedIn peer benchmarking (OFF by default — account ban risk)
ENABLE_LINKEDIN_SCRAPE=false
LINKEDIN_AUTO_SEARCH=false
LINKEDIN_MAX_PEERS=8
LINKEDIN_HEADLESS=false
# CLI: uv run python main.py benchmark <job_id> --auto

# Storage paths
RESUMES_DIR=storage/resumes
SCREENSHOTS_DIR=storage/screenshots
SESSIONS_DIR=storage/sessions
PREP_PACKS_DIR=storage/prep_packs

# Browser / automation (Step 5)
BROWSER_HEADLESS=true
# BROWSER_CHANNEL=chrome
ACTION_DELAY_MS_MIN=80
ACTION_DELAY_MS_MAX=250
TYPING_DELAY_MS_MIN=30
TYPING_DELAY_MS_MAX=90
CREDENTIALS_PATH=config/credentials.yaml
APPLY_LIMIT=10

# Logging
LOG_LEVEL=INFO
